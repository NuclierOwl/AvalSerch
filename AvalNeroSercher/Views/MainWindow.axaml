<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AvalNeroSercher.Converters"
        xmlns:vm="clr-namespace:AvalNeroSercher.ViewModels"
        x:DataType="vm:MainViewModel"
        x:Class="AvalNeroSercher.Views.MainWindow"
        Title="Распознавание цифр с камеры"
        Width="1200" Height="650">

    <Window.Resources>
        <converters:BitmapConverter x:Key="BitmapConverter" />
    </Window.Resources>

    <Grid ColumnDefinitions="2*,*" Margin="10">
        <!-- Левая панель: видео -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
            <Image Source="{Binding CurrentFrame, Converter={StaticResource BitmapConverter}}"
                   Stretch="Uniform" />
        </Border>

        <!-- Правая панель: управление -->
        <ScrollViewer Grid.Column="1" Margin="20,10">
            <StackPanel Spacing="8">
                <TextBlock Text="Выбор камеры" FontWeight="Bold" />
                <ComboBox ItemsSource="{Binding Cameras}"
                          SelectedItem="{Binding SelectedCamera}"
                          IsEnabled="{Binding !IsCapturing}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Spacing="10">
                    <Button Content="▶ Старт"
                            Command="{Binding StartCaptureCommand}"
                            IsEnabled="{Binding !IsCapturing}" />
                    <Button Content="⏹ Стоп"
                            Command="{Binding StopCaptureCommand}"
                            IsEnabled="{Binding IsCapturing}" />
                </StackPanel>

                <Separator Margin="0,16" />

                <TextBlock Text="Модель ML" FontWeight="Bold" />
                <ComboBox ItemsSource="{Binding Models}"
                          SelectedItem="{Binding SelectedModel}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Применить модель"
                            Command="{Binding LoadSelectedModelCommand}" />
                    <Button Content="Обновить список"
                            Command="{Binding RefreshModelsCommand}" />
                    <Button Content="Файл..."
                            Command="{Binding BrowseModelCommand}" />
                </StackPanel>

                <Separator Margin="0,16" />

                <TextBlock Text="Результат распознавания" FontWeight="Bold" />
                <TextBlock FontSize="48"
                           Text="{Binding RecognizedDigit}"
                           Foreground="Green" />
                <TextBlock Text="{Binding Confidence, StringFormat='Уверенность: {0:P1}'}" />

                <Separator Margin="0,16" />

                <TextBlock Text="Внешний API" FontWeight="Bold" />
                <TextBlock Text="{Binding ApiUrl}" TextWrapping="Wrap" />
                <TextBlock Text="GET /api/status, /api/cameras, /api/models"
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                <TextBlock Text="POST /api/capture/start|stop, /api/models/load, /api/predict"
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Opacity="0.8" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
